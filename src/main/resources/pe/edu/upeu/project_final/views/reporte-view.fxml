<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- ADAPTADO: controlador, campos y columnas coinciden con ReporteController, incluidas las mayúsculas. -->
<VBox spacing="15.0" stylesheets="@style.css"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="pe.edu.upeu.project_final.controller.ReporteController">
    <padding>
        <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
    </padding>

    <Label text="Reporte de ventas por fecha"
           style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #014074;"/>

    <HBox spacing="10.0" alignment="CENTER_LEFT">
        <Label text="Fecha de venta:"/>
        <TextField fx:id="txtFecha" promptText="aaaa-mm-dd" prefWidth="160.0"
                   onAction="#handleActualizar"/>
        <Button text="Actualizar" onAction="#handleActualizar" styleClass="button-login"/>
    </HBox>

    <!-- ADAPTADO: estas etiquetas reciben los resultados reales; se retiraron las cifras de ejemplo. -->
    <HBox spacing="15.0">
        <Label fx:id="lblTotal" text="Total vendido: —"/>
        <Label fx:id="lblEntradas" text="Entradas vendidas: —"/>
        <Label fx:id="lblOperaciones" text="Ventas registradas: —"/>
    </HBox>

    <TableView fx:id="tableReporte" prefHeight="350.0" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="ColId" text="ID venta" prefWidth="80.0"/>
            <TableColumn fx:id="ColFuncion" text="ID función" prefWidth="90.0"/>
            <TableColumn fx:id="ColCliente" text="Cliente" prefWidth="160.0"/>
            <TableColumn fx:id="ColCantidad" text="Cantidad" prefWidth="95.0"/>
            <TableColumn fx:id="ColTotal" text="Total (S/)" prefWidth="110.0"/>
            <TableColumn fx:id="ColFecha" text="Fecha de venta" prefWidth="180.0"/>
        </columns>
        <placeholder>
            <Label text="No hay ventas para mostrar."/>
        </placeholder>
    </TableView>

    <Label fx:id="lblEstado" text=""/>
</VBox>
