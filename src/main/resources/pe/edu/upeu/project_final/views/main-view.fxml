<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- ADAPTADO: el menú lateral reúne las seis acciones de MainController y cabe en 1000 x 650. -->
<BorderPane prefHeight="650.0" prefWidth="1000.0" stylesheets="@style.css"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="pe.edu.upeu.project_final.controller.MainController">
    <left>
        <VBox prefWidth="200.0" spacing="20.0" styleClass="sidebar"
              style="-fx-padding: 24 18 18 18;">
            <Label text="CINEMA"
                   style="-fx-text-fill: #EFA30E; -fx-font-weight: bold; -fx-font-size: 25px;"/>
            <VBox spacing="8.0">
                <Button text="Inicio" onAction="#showHome" maxWidth="Infinity" styleClass="nav-button"/>
                <Button text="Películas" onAction="#showClient" maxWidth="Infinity" styleClass="nav-button"/>
                <Button text="Salas" onAction="#showSalas" maxWidth="Infinity" styleClass="nav-button"/>
                <Button text="Funciones" onAction="#showFunciones" maxWidth="Infinity" styleClass="nav-button"/>
                <Button text="Ventas" onAction="#showVentas" maxWidth="Infinity" styleClass="nav-button"/>
                <Button text="Reportes" onAction="#showReportes" maxWidth="Infinity" styleClass="nav-button"/>
            </VBox>
        </VBox>
    </left>
    <center>
        <!-- ADAPTADO: MainController coloca aquí la vista seleccionada. -->
        <StackPane fx:id="contentArea" styleClass="content-area"/>
    </center>
</BorderPane>