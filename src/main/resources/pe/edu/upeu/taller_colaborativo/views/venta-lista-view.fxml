<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="8.0" stylesheets="@style.css"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="pe.edu.upeu.taller_colaborativo.controller.VentaListaController">
    <padding>
        <Insets bottom="15.0" left="25.0" right="25.0" top="22.0"/>
    </padding>
    <children>

        <HBox alignment="CENTER_LEFT" spacing="15.0">
            <children>
                <Label styleClass="titulo-vista" text="Ventas registradas"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button mnemonicParsing="false" onAction="#handleAnular"
                        styleClass="button-action-delete" text="ANULAR VENTA"/>
            </children>
        </HBox>

        <Label styleClass="subtitulo-vista"
               text="Entradas vendidas en esta sesión, con su función y su total."/>

        <TableView fx:id="tableVenta" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colNumero" prefWidth="50.0" text="N°"/>
                <TableColumn fx:id="colId" prefWidth="40.0" text="ID" visible="false"/>
                <TableColumn fx:id="colPelicula" prefWidth="230.0" text="Película"/>
                <TableColumn fx:id="colFuncion" prefWidth="230.0" text="Función"/>
                <TableColumn fx:id="colButacas" prefWidth="180.0" text="Butacas"/>
                <TableColumn fx:id="colTotal" prefWidth="100.0" text="Total"/>
                <TableColumn fx:id="colFecha" prefWidth="100.0" text="Fecha"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>

    </children>
</VBox>
