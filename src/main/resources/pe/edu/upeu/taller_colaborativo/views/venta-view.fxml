<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="6.0" stylesheets="@style.css"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="pe.edu.upeu.taller_colaborativo.controller.VentaController">
    <padding>
        <Insets bottom="15.0" left="25.0" right="25.0" top="22.0"/>
    </padding>
    <children>

        <Label styleClass="titulo-vista" text="Comprar entradas"/>
        <Label styleClass="subtitulo-vista" text="Elija la función y luego las butacas que desea ocupar."/>

        <HBox spacing="18.0" VBox.vgrow="ALWAYS">
            <children>

                <!-- Paso 1: función -->
                <VBox prefWidth="290.0" spacing="10.0" styleClass="panel">
                    <children>
                        <Label styleClass="panel-titulo" text="1. Elija la función"/>
                        <Label styleClass="etiqueta" text="Película y horario"/>
                        <ComboBox fx:id="cboFuncion" maxWidth="Infinity"/>
                        <Label fx:id="lblSala" styleClass="leyenda" wrapText="true"/>
                        <Region VBox.vgrow="ALWAYS"/>
                        <Label styleClass="leyenda-butacas" wrapText="true"
                               text="Las butacas oscuras ya están vendidas para esta función."/>
                    </children>
                </VBox>

                <!-- Paso 2: butacas -->
                <VBox spacing="10.0" styleClass="panel" HBox.hgrow="ALWAYS">
                    <children>
                        <Label styleClass="panel-titulo" text="2. Elija sus butacas"/>
                        <Label styleClass="pantalla" text="PANTALLA" maxWidth="Infinity"/>
                        <ScrollPane fx:id="scrollButacas" fitToHeight="true" fitToWidth="true"
                                    hbarPolicy="AS_NEEDED"
                                    vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS"
                                    style="-fx-background-color: transparent; -fx-background: transparent;">
                            <content>
                                <GridPane fx:id="gridButacas" alignment="CENTER" hgap="3.0" vgap="3.0"/>
                            </content>
                        </ScrollPane>
                        <Label styleClass="leyenda-butacas"
                               text="Gris = libre   ·   Dorado = su selección   ·   Oscuro = ocupada"/>
                    </children>
                </VBox>

                <!-- Paso 3: resumen -->
                <VBox prefWidth="260.0" spacing="10.0" styleClass="panel">
                    <children>
                        <Label styleClass="panel-titulo" text="3. Resumen"/>
                        <Label styleClass="etiqueta" text="Butacas elegidas"/>
                        <Label fx:id="lblResumenButacas" styleClass="valor" wrapText="true"
                               text="Todavía no elegiste ninguna butaca."/>
                        <Label styleClass="etiqueta" text="Total a pagar"/>
                        <Label fx:id="lblTotal" styleClass="total" text="S/ 0.00"/>
                        <Label fx:id="lblPrecioButaca" styleClass="leyenda" text="Precio por butaca: -"/>
                        <Region VBox.vgrow="ALWAYS"/>
                        <Label fx:id="lblMensaje" styleClass="mensaje-error" wrapText="true"/>
                        <Button maxWidth="Infinity" mnemonicParsing="false"
                                onAction="#handleConfirmar" styleClass="button-login"
                                text="CONFIRMAR COMPRA"/>
                    </children>
                </VBox>

            </children>
        </HBox>

    </children>
</VBox>
