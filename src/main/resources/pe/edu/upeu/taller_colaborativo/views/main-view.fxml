<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="1150.0" stylesheets="@style.css"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="pe.edu.upeu.taller_colaborativo.controller.MainController">

    <!-- Cabecera -->
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="65.0" spacing="10.0" styleClass="header">
            <padding>
                <Insets left="20.0" right="20.0"/>
            </padding>
            <children>
                <Label styleClass="header-marca" text="CINE UPeU"/>
                <Label styleClass="header-sub" text="Venta de entradas"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblUsuario" styleClass="usuario" text="Bienvenido"/>
            </children>
        </HBox>
    </top>

    <!-- Menú lateral -->
    <left>
        <VBox prefWidth="210.0" styleClass="sidebar">
            <children>
                <Button fx:id="btnInicio" maxWidth="Infinity" mnemonicParsing="false"
                        onAction="#showInicio" styleClass="nav-button" text="Inicio"/>
                <Button fx:id="btnCartelera" maxWidth="Infinity" mnemonicParsing="false"
                        onAction="#showCartelera" styleClass="nav-button" text="Cartelera"/>
                <Button fx:id="btnPeliculas" maxWidth="Infinity" mnemonicParsing="false"
                        onAction="#showPeliculas" styleClass="nav-button" text="Películas"/>
                <Button fx:id="btnSalas" maxWidth="Infinity" mnemonicParsing="false"
                        onAction="#showSalas" styleClass="nav-button" text="Salas"/>
                <Button fx:id="btnFunciones" maxWidth="Infinity" mnemonicParsing="false"
                        onAction="#showFunciones" styleClass="nav-button" text="Funciones"/>
                <Button fx:id="btnVentas" maxWidth="Infinity" mnemonicParsing="false"
                        onAction="#showVentas" styleClass="nav-button" text="Ventas"/>
                <Button fx:id="btnVenta" maxWidth="Infinity" mnemonicParsing="false"
                        onAction="#showVenta" styleClass="nav-button" text="Comprar entradas"/>
                <Region VBox.vgrow="ALWAYS"/>
                <Button maxWidth="Infinity" mnemonicParsing="false"
                        onAction="#handleLogout" styleClass="nav-button-salir"
                        text="Cerrar sesión"/>
            </children>
        </VBox>
    </left>

    <!-- Área de contenido -->
    <center>
        <VBox>
            <StackPane fx:id="contentArea" styleClass="content-area" VBox.vgrow="ALWAYS"/>
            <HBox alignment="CENTER" prefHeight="24.0" styleClass="pie">
                <children>
                    <Label styleClass="leyenda" text="© 2026 Cine UPeU - Taller Colaborativo"/>
                </children>
            </HBox>
        </VBox>
    </center>

</BorderPane>
