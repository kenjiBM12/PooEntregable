<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="14.0" styleClass="page" stylesheets="@style.css"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="pe.edu.upeu.gestioo_de_cine.controller.UsuarioController">
    <padding>
        <Insets bottom="18.0" left="24.0" right="24.0" top="20.0"/>
    </padding>
    <children>

        <HBox alignment="CENTER_LEFT" spacing="14.0">
            <children>
                <VBox spacing="2.0">
                    <children>
                        <Label styleClass="titulo-vista" text="Usuarios del sistema"/>
                        <Label styleClass="subtitulo-vista"
                               text="Solo el administrador puede registrar, editar y activar cuentas."/>
                    </children>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Button mnemonicParsing="false" onAction="#handleNew" styleClass="button-login" text="+ NUEVO"/>
            </children>
        </HBox>

        <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="toolbar">
            <children>
                <TextField fx:id="txtBuscar" onAction="#handleBuscar"
                           promptText="Buscar por nombre, usuario o rol" HBox.hgrow="ALWAYS"/>
                <Button mnemonicParsing="false" onAction="#handleBuscar" styleClass="button-secundario"
                        text="BUSCAR"/>
            </children>
        </HBox>

        <TableView fx:id="tableUsuario" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="ColNumero" prefWidth="50.0" text="N°"/>
                <TableColumn fx:id="ColNombre" prefWidth="250.0" text="Nombre"/>
                <TableColumn fx:id="ColUsuario" prefWidth="180.0" text="Usuario"/>
                <TableColumn fx:id="ColRol" prefWidth="120.0" text="Rol"/>
                <TableColumn fx:id="ColEstado" prefWidth="120.0" text="Estado"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
            <placeholder>
                <Label styleClass="tabla-vacia" text="No hay usuarios que coincidan con la búsqueda."/>
            </placeholder>
        </TableView>

        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <children>
                <Button mnemonicParsing="false" onAction="#handleEdit" styleClass="button-action-edit"
                        text="EDITAR"/>
                <Button mnemonicParsing="false" onAction="#handleCambiarEstado" styleClass="button-action-delete"
                        text="ACTIVAR / DESACTIVAR"/>
            </children>
        </HBox>

    </children>
</VBox>
