<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox prefHeight="575.0" prefWidth="851.0" spacing="20.0" style="-fx-background-color: #F7F7F7;"
      stylesheets="@style.css" xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1" fx:controller="pe.edu.upeu.gestioo_de_cine.controller.PeliculaController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <HBox alignment="CENTER_LEFT" spacing="15.0">
            <children>
                <Label text="Gestion de Cine" textFill="#014074">
                    <font><Font name="System Bold" size="20.0" /></font>
                </Label>
                <Region HBox.hgrow="ALWAYS" />
                <Button mnemonicParsing="false" onAction="#handleNew" styleClass="button-login" text="+ NUEVO" />
            </children>
        </HBox>

        <TableView fx:id="tablePelicula" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="ColNumero" prefWidth="15.0" text="N°" />
                <TableColumn fx:id="ColNumeroPelicula" prefWidth="100.0" text="Pelicula Numero " />
                <TableColumn fx:id="ColId" prefWidth="30.0" text="ID" />
                <TableColumn fx:id="ColNombre" prefWidth="150.0" text="Nombres" />
                <TableColumn fx:id="ColDuracion" prefWidth="150.0" text="Duracion" />
                <TableColumn fx:id="ColCategoria" prefWidth="130.0" text="Categoría" />
                <TableColumn fx:id="ColClasificacion" prefWidth="130.0" text="Clasificación" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
        <!--Acciones de la tabla -->
        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <children>
                <Button mnemonicParsing="false" onAction="#handleEdit" styleClass="button-action-edit" text="EDITAR" />
                <Button mnemonicParsing="false" onAction="#handleDelete" styleClass="button-action-delete" text="ELIMINAR" />
            </children>
        </HBox>

    </children>



</VBox>
