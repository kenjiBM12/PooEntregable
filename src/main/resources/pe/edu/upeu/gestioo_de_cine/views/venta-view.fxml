<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="14.0" styleClass="page" stylesheets="@style.css"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="pe.edu.upeu.gestioo_de_cine.controller.VentaController">
    <padding>
        <Insets bottom="18.0" left="24.0" right="24.0" top="20.0"/>
    </padding>
    <children>

        <HBox alignment="CENTER_LEFT" spacing="14.0">
            <children>
                <VBox spacing="2.0">
                    <children>
                        <Label styleClass="titulo-vista" text="Venta de entradas"/>
                        <Label styleClass="subtitulo-vista"
                               text="Boletos vendidos: cada fila es un boleto y comparte el código de compra."/>
                    </children>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Button mnemonicParsing="false" onAction="#handleNew" styleClass="button-login"
                        text="+ NUEVA VENTA"/>
            </children>
        </HBox>

        <!--busqueda y filtros -->
        <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="toolbar">
            <children>
                <TextField fx:id="txtBuscar" onAction="#handleBuscar" prefWidth="260.0"
                           promptText="Buscar por código, cliente, DNI, película..." HBox.hgrow="ALWAYS"/>
                <ComboBox fx:id="cbEstado" prefWidth="120.0"/>
                <!-- MEJORA 8: filtrar por el empleado que vendio -->
                <ComboBox fx:id="cbEmpleado" prefWidth="150.0"/>
                <!-- MEJORA 9b: rango de fechas desde / hasta -->
                <Label styleClass="leyenda" text="Desde"/>
                <DatePicker fx:id="dpFecha" prefWidth="130.0"/>
                <Label styleClass="leyenda" text="Hasta"/>
                <DatePicker fx:id="dpFechaHasta" prefWidth="130.0"/>
                <Button mnemonicParsing="false" onAction="#handleBuscar" styleClass="button-secundario"
                        text="BUSCAR"/>
                <Button mnemonicParsing="false" onAction="#handleLimpiar" styleClass="button-secundario"
                        text="LIMPIAR"/>
            </children>
        </HBox>

        <TableView fx:id="tableVenta" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="ColNumero" prefWidth="42.0" text="N°"/>
                <TableColumn fx:id="ColId" prefWidth="30.0" text="ID" visible="false"/>
                <TableColumn fx:id="ColCodigo" prefWidth="90.0" text="Compra"/>
                <TableColumn fx:id="ColCliente" prefWidth="160.0" text="Cliente"/>
                <TableColumn fx:id="ColDni" prefWidth="80.0" text="DNI"/>
                <TableColumn fx:id="ColPelicula" prefWidth="150.0" text="Película"/>
                <TableColumn fx:id="ColSala" prefWidth="100.0" text="Sala"/>
                <TableColumn fx:id="ColFecha" prefWidth="90.0" text="Fecha función"/>
                <!-- la fecha en que se cobro el boleto: es la que usa el cierre de caja -->
                <TableColumn fx:id="ColFechaVenta" prefWidth="95.0" text="Fecha venta"/>
                <TableColumn fx:id="ColHorario" prefWidth="70.0" text="Hora"/>
                <TableColumn fx:id="ColButaca" prefWidth="65.0" text="Butaca"/>
                <TableColumn fx:id="ColEmpleado" prefWidth="110.0" text="Empleado"/>
                <TableColumn fx:id="ColTotal" prefWidth="75.0" text="Precio (S/)"/>
                <!-- MEJORA 2: forma de pago con la que se cobro el boleto -->
                <TableColumn fx:id="ColMetodoPago" prefWidth="85.0" text="Pago"/>
                <TableColumn fx:id="ColEstado" prefWidth="85.0" text="Estado"/>
                <!-- MEJORA 6: quien anulo y por que -->
                <TableColumn fx:id="ColAnulacion" prefWidth="160.0" text="Anulación"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
            <placeholder>
                <Label styleClass="tabla-vacia" text="No hay boletos que coincidan con la búsqueda."/>
            </placeholder>
        </TableView>

        <!--resumen y acciones -->
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <children>
                <Label fx:id="lblResumen" styleClass="resumen" text="Boletos activos: 0"/>
                <Region HBox.hgrow="ALWAYS"/>
                <!-- MEJORA 13: cartelera del dia con hora de fin -->
                <Button mnemonicParsing="false" onAction="#handleCartelera"
                        styleClass="button-secundario" text="CARTELERA"/>
                <!-- MEJORA 9: reimprime el comprobante de la compra elegida -->
                <Button mnemonicParsing="false" onAction="#handleReimprimir"
                        styleClass="button-secundario" text="REIMPRIMIR"/>
                <Button mnemonicParsing="false" onAction="#handleAnularCompra" styleClass="button-action-delete"
                        text="ANULAR COMPRA"/>
                <Button mnemonicParsing="false" onAction="#handleDelete" styleClass="button-action-delete"
                        text="ANULAR BOLETO"/>
            </children>
        </HBox>

    </children>
</VBox>
