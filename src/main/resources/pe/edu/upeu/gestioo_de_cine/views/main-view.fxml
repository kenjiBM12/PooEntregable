<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="640.0" prefWidth="1100.0" stylesheets="@style.css"
            xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="pe.edu.upeu.gestioo_de_cine.controller.MainController">
    <!--cabecera con la marca del cine -->
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="74.0" styleClass="header" BorderPane.alignment="CENTER">
            <children>
                <VBox spacing="0.0">
                    <HBox.margin><Insets left="22.0" /></HBox.margin>
                    <children>
                        <Label styleClass="header-marca" text="CINEMAX" />
                        <Label styleClass="header-sub" text="Sistema de venta de entradas" />
                    </children>
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <VBox alignment="CENTER_RIGHT" spacing="2.0">
                    <HBox.margin><Insets right="22.0" /></HBox.margin>
                    <children>
                        <Label fx:id="lblUsuario" styleClass="usuario" text="" />
                        <Label fx:id="lblRol" styleClass="header-sub" text="" />
                    </children>
                </VBox>
            </children>
        </HBox>
    </top>
    <!--MENU IZQUIERDO -->
    <left>
        <VBox prefWidth="215.0" styleClass="sidebar" BorderPane.alignment="CENTER">
            <children>
                <Label styleClass="menu-titulo" text="MENÚ" />
                <Button fx:id="btnInicio" maxWidth="Infinity" onAction="#showHome" mnemonicParsing="false"
                        styleClass="nav-button" text="Inicio" />
                <Button fx:id="btnClientes" maxWidth="Infinity" onAction="#showCliente" mnemonicParsing="false"
                        styleClass="nav-button" text="Clientes" />
                <Button fx:id="btnPeliculas" maxWidth="Infinity" onAction="#showPeli" mnemonicParsing="false"
                        styleClass="nav-button" text="Películas" />
                <Button fx:id="btnSalas" maxWidth="Infinity" onAction="#showSal" mnemonicParsing="false"
                        styleClass="nav-button" text="Salas" />
                <Button fx:id="btnFunciones" maxWidth="Infinity" onAction="#showFuncion" mnemonicParsing="false"
                        styleClass="nav-button" text="Funciones" />
                <Button fx:id="btnVentas" maxWidth="Infinity" onAction="#showVenta" mnemonicParsing="false"
                        styleClass="nav-button" text="Venta de entradas" />
                <Button fx:id="btnButacas" maxWidth="Infinity" onAction="#showButacas" mnemonicParsing="false"
                        styleClass="nav-button" text="Butacas" />
                <Button fx:id="btnUsuarios" maxWidth="Infinity" onAction="#showUsuarios" mnemonicParsing="false"
                        styleClass="nav-button" text="Usuarios" />
                <!-- MEJORA 3: reportes y cierre de caja -->
                <Button fx:id="btnReportes" maxWidth="Infinity" onAction="#showReportes" mnemonicParsing="false"
                        styleClass="nav-button" text="Reportes" />
                <Region VBox.vgrow="ALWAYS" />
                <Button maxWidth="Infinity" onAction="#handleLogout" mnemonicParsing="false"
                        styleClass="nav-button-salir" text="Cerrar sesión" />
            </children>
        </VBox>
    </left>
    <!--area de contenido (body) -->
    <center>
        <VBox BorderPane.alignment="CENTER">
            <StackPane fx:id="contentArea" styleClass="content-area" VBox.vgrow="ALWAYS">
                <children>
                    <Label styleClass="leyenda" text="Seleccione una opción del menú" />
                </children>
            </StackPane>
            <HBox alignment="CENTER" prefHeight="26.0" styleClass="pie">
                <children>
                    <Label styleClass="leyenda" text="© CINEMAX 2026  ·  Taller de POO - UPeU" />
                </children>
            </HBox>
        </VBox>
    </center>
</BorderPane>
