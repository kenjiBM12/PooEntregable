<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<VBox spacing="8.0" stylesheets="@style.css"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="pe.edu.upeu.gestioo_de_cine.controller.ClienteController">
    <padding>
        <Insets bottom="15.0" left="25.0" right="25.0" top="22.0"/>
    </padding>
    <children>
        <HBox alignment="CENTER_LEFT" spacing="15.0">
            <children>
                <Label styleClass="titulo-vista" text="Gestión de clientes"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button mnemonicParsing="false" onAction="#handleNew"
                        styleClass="button-login" text="+ NUEVO"/>
            </children>
        </HBox>
        <Label styleClass="subtitulo-vista" text="Clientes registrados en el sistema."/>
        <TableView fx:id="tableCliente" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="ColNumero" prefWidth="50.0" text="N°"/>
                <TableColumn fx:id="ColId" prefWidth="40.0" text="ID" visible="false"/>
                <TableColumn fx:id="ColNombre" prefWidth="180.0" text="Nombres"/>
                <TableColumn fx:id="ColApellidos" prefWidth="180.0" text="Apellidos"/>
                <TableColumn fx:id="ColDni" prefWidth="100.0" text="DNI"/>
                <TableColumn fx:id="ColEmail" prefWidth="230.0" text="Email"/>
                <TableColumn fx:id="ColGenero" prefWidth="100.0" text="Género"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <children>
                <Button mnemonicParsing="false" onAction="#handleEdit"
                        styleClass="button-action-edit" text="EDITAR"/>
                <Button mnemonicParsing="false" onAction="#handleDelete"
                        styleClass="button-action-delete" text="ELIMINAR"/>
            </children>
        </HBox>
    </children>
</VBox>
