<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<StackPane fx:id="mainContainer" styleClass="page" stylesheets="@style.css"
           xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml">
    <children>
        <VBox alignment="CENTER" spacing="18.0">
            <children>
                <Label styleClass="titulo-vista" text="Bienvenido a CINEMAX"/>
                <Label styleClass="subtitulo-vista"
                       text="Elija una opción del menú: clientes, películas, salas, funciones, butacas, venta de entradas o usuarios."/>
                <ImageView fx:id="imgCine" fitHeight="420.0"
                           fitWidth="760.0" pickOnBounds="true" preserveRatio="true"
                           styleClass="poster">
                    <image>
                        <Image url="@../img/cine_portada.png"/>
                    </image>
                </ImageView>
            </children>
        </VBox>
    </children>
</StackPane>
