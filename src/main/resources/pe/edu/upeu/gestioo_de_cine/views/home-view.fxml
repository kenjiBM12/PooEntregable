<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane styleClass="content-area" stylesheets="@style.css"
           xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <VBox alignment="TOP_LEFT" spacing="8.0">
            <padding>
                <Insets bottom="20.0" left="25.0" right="25.0" top="22.0"/>
            </padding>
            <children>
                <Label styleClass="titulo-vista" text="Panel de inicio"/>
                <Label styleClass="subtitulo-vista" text="Bienvenido al sistema de gestión del cine."/>

                <ImageView fx:id="imgCine" fitHeight="430.0" fitWidth="760.0"
                           pickOnBounds="true" preserveRatio="true">
                    <VBox.margin>
                        <Insets top="14.0"/>
                    </VBox.margin>
                    <image>
                        <Image url="@../img/cine_portada.png"/>
                    </image>
                </ImageView>
            </children>
        </VBox>
    </children>
</StackPane>
