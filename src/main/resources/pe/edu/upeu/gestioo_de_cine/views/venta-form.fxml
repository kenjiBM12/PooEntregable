<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="-Infinity" spacing="12.0" styleClass="form-dialogo"
      stylesheets="@style.css" xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1" fx:controller="pe.edu.upeu.gestioo_de_cine.controller.VentaFormController">
    <padding>
        <Insets bottom="20.0" left="26.0" right="26.0" top="20.0" />
    </padding>
    <children>

        <Label styleClass="titulo-form" text="Venta de entradas" />
        <Label styleClass="leyenda" text="Paso 1: elija la película y la función.
        Paso 2: marque una o varias butacas libres." />
        <Separator />

        <!-- Paso 1: pelicula y funcion -->
        <Label styleClass="panel-titulo" text="1. Película y función" />
        <GridPane hgap="12.0" vgap="10.0">
            <columnConstraints>
                <ColumnConstraints prefWidth="110.0" />
                <ColumnConstraints hgrow="ALWAYS" prefWidth="480.0" />
            </columnConstraints>
            <children>
                <Label styleClass="etiqueta" text="Película" GridPane.rowIndex="0" />
                <ComboBox fx:id="cboPelicula" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                <Label styleClass="etiqueta" text="Función" GridPane.rowIndex="1" />
                <ComboBox fx:id="cboFuncion" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            </children>
         <rowConstraints>
            <RowConstraints />
            <RowConstraints />
         </rowConstraints>
        </GridPane>

        <!-- Paso 2: butacas -->
        <Label styleClass="panel-titulo" text="2. Elija las butacas" />
        <Label maxWidth="Infinity" styleClass="pantalla" text="PANTALLA" />
        <ScrollPane fitToHeight="true" fitToWidth="true" hbarPolicy="AS_NEEDED"
                    prefHeight="190.0" style="-fx-background-color: transparent; -fx-background: transparent;"
                    vbarPolicy="AS_NEEDED">
            <content>
                <GridPane fx:id="gridButacas" alignment="CENTER" hgap="5.0" vgap="5.0" />
            </content>
        </ScrollPane>
        <Label styleClass="leyenda-butacas" text="Número = libre   ·   Dorado = elegida   ·   ✕ = ocupada" />

        <HBox spacing="25.0">
            <children>
                <Label fx:id="lblButaca" styleClass="leyenda" text="Butaca: -" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="lblPrecio" styleClass="leyenda" text="Precio: -" />
            </children>
        </HBox>

        <!-- Paso 3: datos del cliente -->
        <Label styleClass="panel-titulo" text="3. Datos del cliente" />
        <GridPane hgap="12.0" vgap="10.0">
            <columnConstraints>
                <ColumnConstraints prefWidth="110.0" />
                <ColumnConstraints hgrow="ALWAYS" prefWidth="480.0" />
            </columnConstraints>
            <children>
                <Label styleClass="etiqueta" text="DNI" GridPane.rowIndex="0" />
                <TextField fx:id="txtDni" maxWidth="240.0" promptText="8 números, ejemplo: 74581236" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                <Label styleClass="etiqueta" text="Nombres" GridPane.rowIndex="1" />
                <TextField fx:id="txtNombre" promptText="Ejemplo: Kenji" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                <Label styleClass="etiqueta" text="Email" GridPane.rowIndex="2" />
                <TextField fx:id="txtEmail" promptText="Ejemplo: Kenji@gmail.com" GridPane.columnIndex="1" GridPane.rowIndex="2" />



                <Label styleClass="etiqueta" text="Apellidos" GridPane.rowIndex="3" />
                <TextField fx:id="txtApellidos" promptText="Ejemplo: Briceño Mercedes" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                <Label styleClass="etiqueta" text="Teléfono" GridPane.rowIndex="4" />
                <TextField fx:id="txtTelefono" maxWidth="240.0" promptText="Ejemplo: 987654321" GridPane.columnIndex="1" GridPane.rowIndex="4" />
            </children>
         <rowConstraints>
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
         </rowConstraints>
        </GridPane>

        <Label fx:id="lblMensaje" styleClass="mensaje-error" wrapText="true" />

        <!-- Paso 4: vender -->
        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <children>
                <Button mnemonicParsing="false" onAction="#handleCancel" prefHeight="34.0" prefWidth="110.0" styleClass="button-secundario" text="Cancelar" />
                <Button mnemonicParsing="false" onAction="#handleVender" prefHeight="34.0" prefWidth="140.0" styleClass="button-login" text="VENDER" />
            </children>
        </HBox>

    </children>
</VBox>
