<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefWidth="660.0" spacing="12.0" styleClass="form-dialogo" stylesheets="@style.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pe.edu.upeu.gestioo_de_cine.controller.VentaFormController">
    <padding>
        <Insets bottom="20.0" left="26.0" right="26.0" top="20.0" />
    </padding>
    <children>

        <Label styleClass="titulo-form" text="Venta de entradas" />
        <Label styleClass="leyenda" text="Paso 1: elija la película y la función.         Paso 2: marque una o varias butacas libres." />
        <Separator />
        <VBox fx:id="panelPaso12" spacing="12.0">
            <children>
        <!-- Paso 1: pelicula y funcion -->
        <Label styleClass="panel-titulo" text="1. Película y función" />
        <GridPane hgap="12.0" vgap="10.0">
            <columnConstraints>
                <ColumnConstraints prefWidth="110.0" />
                <ColumnConstraints hgrow="ALWAYS" prefWidth="480.0" />
            </columnConstraints>
            <children>
                <Label styleClass="etiqueta" text="Película" GridPane.rowIndex="0" />
                <ComboBox fx:id="cboPelicula" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                <Label styleClass="etiqueta" text="Función" GridPane.rowIndex="1" />
                <ComboBox fx:id="cboFuncion" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            </children>
         <rowConstraints>
            <RowConstraints />
            <RowConstraints />
         </rowConstraints>
        </GridPane>

        <!-- Paso 2: butacas -->
        <Label styleClass="panel-titulo" text="2. Elija las butacas" />
        <Label maxWidth="Infinity" styleClass="pantalla" text="PANTALLA" />
        <ScrollPane fitToHeight="true" fitToWidth="true" hbarPolicy="AS_NEEDED" prefHeight="190.0" style="-fx-background-color: transparent; -fx-background: transparent;" vbarPolicy="AS_NEEDED">
            <content>
                <GridPane fx:id="gridButacas" alignment="CENTER" hgap="5.0" prefHeight="207.0" prefWidth="606.0" vgap="5.0" />
            </content>
        </ScrollPane>
        <Label styleClass="leyenda-butacas" text="Número = libre   ·   Dorado = elegida   ·   ✕ = ocupada" />

        <HBox spacing="25.0">
            <children>
                <Label fx:id="lblButaca" styleClass="leyenda" text="Butaca: -" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="lblPrecio" styleClass="leyenda" text="Precio: -" />
            </children>
        </HBox>

        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <children>
                <Button fx:id="btnCancelar1" mnemonicParsing="false" onAction="#handleCancel" prefHeight="34.0" prefWidth="110.0" styleClass="button-secundario" text="Cancelar" />
                <Button fx:id="btnSiguiente" mnemonicParsing="false" onAction="#handleSiguiente" prefHeight="34.0" prefWidth="140.0" styleClass="button-login" text="SIGUIENTE" />
            </children>
        </HBox>
            </children></VBox>
        <VBox fx:id="panelPaso3" managed="false" spacing="12.0" visible="false">
            <children>
        <!-- Paso 3: datos del cliente -->
        <Label styleClass="panel-titulo" text="3. Datos del cliente" />
        <GridPane hgap="12.0" vgap="10.0">
            <columnConstraints>
                <ColumnConstraints prefWidth="110.0" />
                <ColumnConstraints hgrow="ALWAYS" prefWidth="480.0" />
            </columnConstraints>
            <children>
                <Label styleClass="etiqueta" text="DNI" GridPane.rowIndex="0" />
                <TextField fx:id="txtDni" maxWidth="240.0" promptText="8 números, ejemplo: 74581236"
                           GridPane.columnIndex="1" GridPane.rowIndex="0" />

                <Label styleClass="etiqueta" text="Nombres" GridPane.rowIndex="1" />
                <TextField fx:id="txtNombre" promptText="Ejemplo: Kenji" GridPane.columnIndex="1"
                           GridPane.rowIndex="1" />

                <Label styleClass="etiqueta" text="Apellidos" GridPane.rowIndex="2" />
                <TextField fx:id="txtApellidos" promptText="Ejemplo: Briceño Mercedes"
                           GridPane.columnIndex="1" GridPane.rowIndex="2" />

                <Label styleClass="etiqueta" text="Email" GridPane.rowIndex="3" />
                <TextField fx:id="txtEmail" promptText="Ejemplo: Kenji@gmail.com"
                           GridPane.columnIndex="1" GridPane.rowIndex="3" />




                <!-- CORREGIDO: el controlador ya tenia cbgenero pero el campo no
                     existia en el FXML, asi que quedaba null al buscar el DNI -->
                <Label styleClass="etiqueta" text="Género" GridPane.rowIndex="4" />
                <ComboBox fx:id="cbgenero" maxWidth="240.0" GridPane.columnIndex="1" GridPane.rowIndex="4" />

                <Label styleClass="etiqueta" text="Teléfono" GridPane.rowIndex="5" />
                <TextField fx:id="txtTelefono" maxWidth="240.0" promptText="Ejemplo: 987654321" GridPane.columnIndex="1" GridPane.rowIndex="5" />
            </children>
         <rowConstraints>
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
         </rowConstraints>
        </GridPane>

        <Label fx:id="lblMensaje" styleClass="mensaje-error" wrapText="true" />

        <!-- Paso 4: vender -->
                <HBox alignment="CENTER_RIGHT" spacing="10.0">
                    <children>
                        <Button mnemonicParsing="false" onAction="#handleVolver" prefHeight="34.0" prefWidth="110.0" styleClass="button-secundario" text="Volver" />
                        <Button mnemonicParsing="false" onAction="#handleCancel" prefHeight="34.0" prefWidth="110.0" styleClass="button-secundario" text="Cancelar" />
                        <Button mnemonicParsing="false" onAction="#handleVender" prefHeight="34.0" prefWidth="140.0" styleClass="button-login" text="VENDER" />
                    </children>
                </HBox>
            </children></VBox>
    </children>
</VBox>
