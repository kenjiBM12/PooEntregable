<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefWidth="470.0" spacing="14.0" styleClass="form-dialogo" stylesheets="@style.css"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="pe.edu.upeu.gestioo_de_cine.controller.SalaFormController">
    <padding>
        <Insets bottom="22.0" left="26.0" right="26.0" top="22.0"/>
    </padding>
    <children>

        <Label fx:id="lblTitulo" styleClass="titulo-form" text="Datos de la sala"/>
        <Label styleClass="leyenda"
               text="La sala se mostrará como &quot;Sala 2 — 3D&quot; usando el número y el tipo."/>
        <Separator/>

        <GridPane hgap="12.0" vgap="12.0">
            <columnConstraints>
                <ColumnConstraints prefWidth="110.0"/>
                <ColumnConstraints hgrow="ALWAYS" prefWidth="290.0"/>
            </columnConstraints>
            <children>
                <Label styleClass="etiqueta" text="Número" GridPane.rowIndex="0"/>
                <TextField fx:id="txtNumero" promptText="Número único, ejemplo: 2"
                           GridPane.columnIndex="1"/>

                <!-- el nombre ya no se pide: se arma solo con el número de la sala -->
                <Label styleClass="etiqueta" text="Tipo de sala" GridPane.rowIndex="1"/>
                <ComboBox promptText="Elige tipo de sala" fx:id="cbTipoSala" maxWidth="Infinity" GridPane.columnIndex="1"
                          GridPane.rowIndex="1"/>

                <Label styleClass="etiqueta" text="Capacidad" GridPane.rowIndex="2"/>
                <TextField fx:id="txtCapacidad" promptText="Butacas, ejemplo: 120"
                           GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                <Label styleClass="etiqueta" text="Estado" GridPane.rowIndex="3"/>
                <ComboBox promptText="Elige una opcion" fx:id="cbEstado" maxWidth="Infinity" GridPane.columnIndex="1"
                          GridPane.rowIndex="3"/>
            </children>
        </GridPane>

        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <children>
                <Button mnemonicParsing="false" onAction="#handleCancel"
                        prefHeight="32.0" prefWidth="110.0" styleClass="button-secundario"
                        text="Cancelar"/>
                <Button mnemonicParsing="false" onAction="#handleSave"
                        prefHeight="32.0" prefWidth="110.0" styleClass="button-login"
                        text="Guardar"/>
            </children>
        </HBox>
    </children>
</VBox>
