<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="14.0" styleClass="page" stylesheets="@style.css"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="pe.edu.upeu.gestioo_de_cine.controller.FuncionController">
    <padding>
        <Insets bottom="18.0" left="24.0" right="24.0" top="20.0"/>
    </padding>
    <children>

        <HBox alignment="CENTER_LEFT" spacing="14.0">
            <children>
                <VBox spacing="2.0">
                    <children>
                        <Label styleClass="titulo-vista" text="Cartelera de funciones"/>
                        <Label styleClass="subtitulo-vista" text="Película, sala, fecha, hora y precio de cada función."/>
                    </children>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Button mnemonicParsing="false" onAction="#handleNew" styleClass="button-login"
                        text="+ NUEVA FUNCIÓN"/>
            </children>
        </HBox>

        <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="toolbar">
            <children>
                <TextField fx:id="txtBuscar" onAction="#handleBuscar"
                           promptText="Buscar por película, sala, fecha u hora" HBox.hgrow="ALWAYS"/>
                <Button mnemonicParsing="false" onAction="#handleBuscar" styleClass="button-secundario"
                        text="BUSCAR"/>
            </children>
        </HBox>

        <TableView fx:id="tableFuncion" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="ColNumero" prefWidth="42.0" text="N°"/>
                <TableColumn fx:id="ColId" prefWidth="30.0" text="ID" visible="false"/>
                <TableColumn fx:id="ColPelicula" prefWidth="220.0" text="Película"/>
                <TableColumn fx:id="ColSala" prefWidth="150.0" text="Sala"/>
                <TableColumn fx:id="ColFecha" prefWidth="110.0" text="Fecha"/>
                <TableColumn fx:id="ColHorario" prefWidth="100.0" text="Hora"/>
                <!-- MEJORA 13: hora de fin calculada con la duracion de la pelicula -->
                <TableColumn fx:id="ColFin" prefWidth="90.0" text="Termina"/>
                <TableColumn fx:id="ColPrecio" prefWidth="110.0" text="Precio (S/)"/>
                <!-- MEJORA 7: activa o cancelada -->
                <TableColumn fx:id="ColEstado" prefWidth="100.0" text="Estado"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
            <placeholder>
                <Label styleClass="tabla-vacia" text="No hay funciones que coincidan con la búsqueda."/>
            </placeholder>
        </TableView>

        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <children>
                <!-- MEJORA 7: cancela la funcion y avisa a los compradores -->
                <Button mnemonicParsing="false" onAction="#handleCancelar"
                        styleClass="button-action-delete" text="CANCELAR FUNCIÓN"/>
                <Button mnemonicParsing="false" onAction="#handleEdit" styleClass="button-action-edit"
                        text="EDITAR"/>
                <Button mnemonicParsing="false" onAction="#handleDelete" styleClass="button-action-delete"
                        text="ELIMINAR"/>
            </children>
        </HBox>

    </children>
</VBox>
