<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.text.Font?>
<StackPane fx:id="mainContainer" style="-fx-background-color: #F7F7F7"
           xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml">
    <children>
        <VBox alignment="CENTER" spacing="30.0">
        <children>
            <Label text="Bienvenido al sistema de gestión de cine" textFill="#014074">
                <font>
                    <Font name="System Bold" size="28.0"/>
                </font>
            </Label>
            <ImageView fx:id="imgCine" fitHeight="450.0"
                       fitWidth="800.0" pickOnBounds="true" preserveRatio="true">
                <image>
                    <Image url="@../img/Cine_portada.png"/>
                </image>
            </ImageView>


        </children>

        </VBox>

    </children>

</StackPane>

