<?xml version="1.0" encoding="UTF-8"?>

<!--
    FXML describe la estructura visual; el controlador Java contiene el comportamiento.
    Portada de Inicio: contiene la imagen del cine.
    fx:controller indica qué clase atiende esta vista.
    fx:id debe coincidir con el campo anotado @FXML de esa clase.
    onAction="#metodo" conecta un botón con el método correspondiente.
    stylesheets="@style.css" carga el estilo desde la carpeta de este FXML.
    VBox organiza verticalmente y HBox horizontalmente.
    TableView contiene las filas; TableColumn describe cada columna.
    Los datos de las celdas se enlazan en initialize(), no se escriben en este archivo.
-->

<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.StackPane?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" style="-fx-background-color: #F7F7F7;">
    <children>
        <ImageView fitHeight="400.0" fitWidth="550.0" pickOnBounds="true" preserveRatio="true">
            <image>
                <Image url="@../img/Cine_portada.png" />
            </image>
        </ImageView>
    </children>
</StackPane>