<?xml version="1.0" encoding="UTF-8"?>

<!--
    FXML describe la estructura visual; el controlador Java contiene el comportamiento.
    Vista de tabla: lista registros y permite abrir formularios de Nuevo o Editar.
    fx:controller indica qué clase atiende esta vista.
    fx:id debe coincidir con el campo anotado @FXML de esa clase.
    onAction="#metodo" conecta un botón con el método correspondiente.
    stylesheets="@style.css" carga el estilo desde la carpeta de este FXML.
    VBox organiza verticalmente y HBox horizontalmente.
    TableView contiene las filas; TableColumn describe cada columna.
    Los datos de las celdas se enlazan en initialize(), no se escriben en este archivo.
-->
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.proyecto_final.controller.PeliculaController"
      spacing="15" style="-fx-padding: 20;" stylesheets="@style.css">
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Gestión de Películas" style="-fx-font-size: 22;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Nuevo" onAction="#handleNew"/>
        <Button text="Editar" onAction="#handleEdit"/>
        <Button text="Eliminar" onAction="#handleDelete"/>
    </HBox>
    <TableView fx:id="tabla" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colNumero" text="N.º" prefWidth="50"/>
            <TableColumn fx:id="colId" text="ID" prefWidth="130"/>
            <TableColumn fx:id="colTitulo" text="Título" prefWidth="130"/>
            <TableColumn fx:id="colGenero" text="Género" prefWidth="130"/>
            <TableColumn fx:id="colDuracion" text="Duración (min)" prefWidth="130"/>
            <TableColumn fx:id="colClasificacion" text="Clasificación" prefWidth="130"/>
        </columns>
    </TableView>
</VBox>
