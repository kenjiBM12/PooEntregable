<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.proyecto_final.controller.VentaController"
      spacing="15" style="-fx-padding: 20;" stylesheets="@style.css">
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Gestión de Ventas" style="-fx-font-size: 22;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Nuevo" onAction="#handleNew"/>
        <Button text="Editar" onAction="#handleEdit"/>
        <Button text="Eliminar" onAction="#handleDelete"/>
    </HBox>
    <TableView fx:id="tabla" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colNumero" text="N.º" prefWidth="50"/>
            <TableColumn fx:id="colId" text="ID" prefWidth="130"/>
            <TableColumn fx:id="colCliente" text="Cliente" prefWidth="130"/>
            <TableColumn fx:id="colPelicula" text="Película" prefWidth="130"/>
            <TableColumn fx:id="colCantidad" text="Cantidad" prefWidth="130"/>
            <TableColumn fx:id="colTotal" text="Total" prefWidth="130"/>
            <TableColumn fx:id="colFecha" text="Fecha" prefWidth="130"/>
        </columns>
    </TableView>
</VBox>
