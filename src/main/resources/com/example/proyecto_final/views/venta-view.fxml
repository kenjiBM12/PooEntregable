<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>
<VBox spacing="20.0" style="-fx-background-color: #F7F7F7;"
      stylesheets="@style.css" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.proyecto_final.controller.VentaController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>
    <children>
        <HBox alignment="CENTER_LEFT" spacing="15.0">
            <children>
                <Label text="Gestión de ventas" textFill="#014074">
                    <font><Font name="System Bold" size="20.0"/></font>
                </Label>
                <Region HBox.hgrow="ALWAYS"/>
                <Button mnemonicParsing="false" styleClass="button-primary" onAction="#handleNew"  text="+ NUEVO" />
            </children>
        </HBox>

        <TableView fx:id="tableVenta" VBox.vgrow="ALWAYS" >
            <columns>
                <TableColumn fx:id="ColNum" prefWidth="30.0" text="N°"/>
                <TableColumn fx:id="ColId" prefWidth="30.0" text="ID" visible="false"/>
                <TableColumn fx:id="ColCliente" prefWidth="140.0" text="Cliente"/>
                <TableColumn fx:id="ColPelicula" prefWidth="170.0" text="Película"/>
                <TableColumn fx:id="ColCantidad" prefWidth="80.0" text="Cantidad"/>
                <TableColumn fx:id="ColTotal" prefWidth="90.0" text="Total (S/)"/>
                <TableColumn fx:id="ColFecha" prefWidth="100.0" text="Fecha de venta"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
        <!--Acciones de la tabla -->
        <HBox alignment="CENTER_RIGHT" spacing="10.0" >
            <children>
                <Button mnemonicParsing="false"  onAction="#handleEdit" styleClass="button-action-edit" text="EDITAR"  />
                <Button mnemonicParsing="false" onAction="#handleDelete" styleClass="button-action-delete" text="ELIMINAR"  />
            </children>
        </HBox>

    </children>



</VBox>

