<?xml version="1.0" encoding="UTF-8"?>

<!--
    FXML describe la estructura visual; el controlador Java contiene el comportamiento.
    Reporte: muestra las ventas de la fecha seleccionada y sus totales reales.
    fx:controller indica qué clase atiende esta vista.
    fx:id debe coincidir con el campo anotado @FXML de esa clase.
    onAction="#metodo" conecta un botón con el método correspondiente.
    stylesheets="@style.css" carga el estilo desde la carpeta de este FXML.
    VBox organiza verticalmente y HBox horizontalmente.
    TableView contiene las filas; TableColumn describe cada columna.
    Los datos de las celdas se enlazan en initialize(), no se escriben en este archivo.
-->
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.proyecto_final.controller.ReporteController"
      spacing="18" stylesheets="@style.css" style="-fx-background-color: #F7F7F7;">
    <padding><Insets top="25" right="25" bottom="25" left="25"/></padding>
    <Label text="Reporte de ventas del día"
           style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #014074;"/>
    <HBox spacing="12" alignment="CENTER_LEFT">
        <Label text="Fecha de venta:"/>
        <DatePicker fx:id="dpFecha" editable="false"/>
        <Button text="Actualizar" onAction="#handleActualizar"/>
    </HBox>
    <FlowPane hgap="25" vgap="12"
              style="-fx-background-color: white; -fx-padding: 18; -fx-background-radius: 8;">
        <Label fx:id="lblTotal" text="Total vendido: S/ 0.00"
               style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #18834b;"/>
        <Label fx:id="lblEntradas" text="Entradas vendidas: 0"
               style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #014074;"/>
        <Label fx:id="lblOperaciones" text="Ventas registradas: 0"
               style="-fx-font-size: 16; -fx-text-fill: #014074;"/>
    </FlowPane>
    <TableView fx:id="tablaReportes" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colIdVenta" text="ID" prefWidth="55"/>
            <TableColumn fx:id="colPelicula" text="Película" prefWidth="190"/>
            <TableColumn fx:id="colCliente" text="Cliente" prefWidth="150"/>
            <TableColumn fx:id="colCantidad" text="Entradas" prefWidth="80"/>
            <TableColumn fx:id="colTotal" text="Total (S/)" prefWidth="100"/>
            <TableColumn fx:id="colHora" text="Hora (Perú)" prefWidth="100"/>
        </columns>
    </TableView>
    <Label fx:id="lblEstado" wrapText="true" style="-fx-text-fill: #666666;"/>
</VBox>
